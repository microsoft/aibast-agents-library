{
  "name": "@aibast/rapp-brainstem-beta-launcher",
  "version": "0.1.0-beta.1",
  "description": "Skill Recorder-style desktop launcher for the shared RAPP Brainstem runtime.",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.19.0 <26",
    "npm": ">=11.6.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.mjs && node --check electron/brain-surgeon.mjs && node --check electron/brainstem-process.mjs && node --check electron/copilot-runtime.mjs && node --check electron/copilot-studio-auth.mjs && node --check electron/rapp-protocol.mjs && node --check electron/route-manager.mjs && node --check electron/ui-driver-server.mjs && node --check electron/update-manager.mjs && node --check electron/update-runner.mjs && node --check electron/video-tools.mjs && node --check scripts/brainstem-chat.mjs && node --check scripts/drive-via-chat.mjs && node --check scripts/package-gate.mjs && node --check scripts/surgeon-chat.mjs && node --check scripts/walkthrough-certify.mjs && node --check scripts/walkthrough-gate.mjs && node --check scripts/walkthrough-provenance.mjs && node --check scripts/walkthrough-via-chat.mjs && node --check ui/renderer.js",
    "brainstem:chat": "node scripts/brainstem-chat.mjs",
    "drive:e2e": "node scripts/drive-via-chat.mjs",
    "surgeon:chat": "node scripts/surgeon-chat.mjs",
    "walkthrough:e2e": "node scripts/walkthrough-via-chat.mjs",
    "walkthrough:certify": "node scripts/walkthrough-certify.mjs",
    "walkthrough:gate": "node scripts/walkthrough-gate.mjs",
    "walkthrough:ingest": "node scripts/walkthrough-via-chat.mjs --ingest-existing",
    "walkthrough:repeat": "node scripts/walkthrough-via-chat.mjs --scenario repeat-ephemeral",
    "walkthrough:stack-churn": "node scripts/walkthrough-via-chat.mjs --scenario stack-churn",
    "test": "node --test tests/*.test.mjs",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "package:gate": "node scripts/package-gate.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@github/copilot-sdk": "^1.0.6",
    "fflate": "^0.8.3",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.6"
  },
  "build": {
    "appId": "com.microsoft.aibast.rapp-brainstem-beta",
    "productName": "RAPP Brainstem Beta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "scripts/brainstem-chat.mjs",
      "scripts/brainstem_ui_driver_agent.py",
      "scripts/surgeon-chat.mjs",
      "scripts/walkthrough-gate.mjs",
      "scripts/walkthrough-provenance.mjs",
      "scripts/walkthrough-via-chat.mjs",
      "resources/**",
      "ui/**",
      "package.json",
      "VERSION",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/@github/copilot-*/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "RAPP Brainstem Beta uses the microphone only when you explicitly enable voice mode."
      },
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "RAPP Brainstem Beta ${version}",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
