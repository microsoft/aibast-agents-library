    "Manufacturing"
  ],
  "personas": [
    "Sales Operations Specialists",
    "Sales Operations Managers",
    "Product Configuration Analysts"
  ],
  "products": [
    "Microsoft Outlook",
    "Microsoft Teams",
    "Dynamics 365"
  ],
  "capabilities": [
    "Reads each PO into structured fields and shows the queue",
    "Validates the PO against the accepted quote with a per-line price tolerance",
    "Checks the configuration and classifies the order",
    "Prepares a draft sales order with every exception for the specialist"
  ],
  "value": [
    "Cuts manual re-keying and line-by-line quote comparison for every purchase order.",
    "Stops price, terms and configuration errors before they reach the ERP.",
    "Lets specialists enter ready orders first and route exceptions with a named reason."
  ],
