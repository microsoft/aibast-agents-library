    "stacks": "api/v1/stacks.json",
    "surface": "api/v1/surfaces/{id}.json",
    "rapp": "api/v1/rapp/index.json",
    "rapp_step": "api/v1/rapp/steps/{n}.json",
    "rapp_concept": "api/v1/rapp/concepts/{slug}.json",
    "rapp_glossary": "api/v1/rapp/glossary.json",
    "rapp_tools": "api/v1/rapp/tools.json",
    "public": "api/v1/public/index.json",
    "public_doc": "api/v1/public/{id}.json",
    "media": "api/v1/media/index.json",
    "media_group": "api/v1/media/{group}.json",
    "gallery": "api/v1/gallery/index.json",
    "gallery_solution": "api/v1/gallery/{slug}.json",
    "status": "api/v1/status.json",
    "badge": "api/v1/badge.json",
    "registry": "api/registry.json"
  }
