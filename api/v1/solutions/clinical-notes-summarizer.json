    "Primary care physicians",
    "Surgeons",
    "Anesthesia teams"
  ],
  "products": [
    "Dynamics 365"
  ],
  "capabilities": [
    "Automatically generate concise, clinically relevant patient summaries",
    "Surface key risks, comorbidities, and medication considerations",
    "Standardize documentation to support smoother surgical and anesthesia workflows",
    "Send summaries through EHR and secure messaging systems"
  ],
  "value": [
    "Makes source-fact review more consistent across encounter, medication, problem-list, and referral contexts.",
    "Reduces coordination friction by producing concise drafts with explicit source uncertainty.",
    "Protects clinical accountability by reserving diagnosis, treatment, clearance, urgency, and record changes for qualified reviewers."
  ],
