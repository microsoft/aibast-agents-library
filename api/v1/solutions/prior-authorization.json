  "name": "Prior Authorization Agent",
  "headline": "Make authorization evidence reviewable without automating the decision",
  "summary": "Give utilization teams a read-only synthetic inventory of request evidence, policy checklist context, recorded workflow state, and reconsideration material—without predicting, submitting, granting, or denying authorization.",
  "industries": [
    "Healthcare",
    "Financial Services"
  ],
  "personas": [
    "Utilization Management Coordinators",
    "Nurse Case Managers",
    "Radiology Schedulers"
  ],
  "products": [
    "Microsoft Teams"
  ],
  "capabilities": [
    "Pull payer‑specific requirements and match them with EHR data",
    "Compile the full clinical evidence packet needed for medical review",
    "Submit requests directly to payer portals and send real‑time updates",
    "Flag cases requiring additional documentation and prepare appeal materials proactively"
  ],
  "value": [
    "Improves consistency in criteria-to-evidence review and missing-document handoffs.",
    "Clarifies source-recorded workflow states without presenting them as agent decisions.",
    "Supports minimum-necessary reconsideration preparation while retaining qualified utilization review."
  ],
