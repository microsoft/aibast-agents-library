#!/usr/bin/env bash
# brainstem-proto: rapid prototyping on the Brainstem the one-liner installed.
# It never writes inside ~/.brainstem. It only starts that kernel, unchanged, with your project's agents.
set -euo pipefail
PROTO_HOME="${PROTO_HOME:-$HOME/.brainstem-proto}"
PROJECTS="${BRAINSTEM_PROTOTYPES:-$HOME/BrainstemPrototypes}"
cmd="${1:-help}"; shift || true
PACK_VERSION="0.1.0"
FEEDBACK_REPO="${PROTO_FEEDBACK_REPO:-microsoft/aibast-agents-library}"

# Usage log: counts and timestamps only. Never a prototype's content, a name, or a transcript.
# Stays on this computer; `brainstem-proto usage` shows it. Nothing is sent anywhere.
track() {
  [ -n "${PROTO_NO_USAGE:-}" ] && return 0
  mkdir -p "$PROTO_HOME"; [ -f "$PROTO_HOME/install-id" ] || (uuidgen 2>/dev/null || date +%s%N) | tr '[:upper:]' '[:lower:]' > "$PROTO_HOME/install-id"
  printf '{"t":"%s","event":"%s","version":"%s"%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$PACK_VERSION" "${2:+,$2}" >> "$PROTO_HOME/usage.jsonl"
}

slug() { printf '%s' "$*" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-40; }
free_pair() {  # first free pair of ports, starting 7096/7097, never 7071
  for p in $(seq 7096 2 7196); do
    if ! lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && ! lsof -nP -iTCP:$((p+1)) -sTCP:LISTEN >/dev/null 2>&1; then echo "$p $((p+1))"; return; fi
  done; echo "7096 7097"
}
project_dir() { local d="$PWD"; while [ "$d" != "/" ]; do [ -f "$d/AGENTS.md" ] && [ -d "$d/brainstem/agents" ] && { echo "$d"; return; }; d="$(dirname "$d")"; done; return 1; }
ports() { [ -f "$1/.proto-ports" ] && cat "$1/.proto-ports" || echo "7096 7097"; }

case "$cmd" in
  new)
    transcript=""; template=""
    if [ "${1:-}" = "--template" ]; then template="${2:?--template needs a name (brainstem-proto templates)}"; shift 2; fi
    if [ "${1:-}" = "--transcript" ]; then transcript="${2:?--transcript needs a file}"; shift 2
      [ -f "$transcript" ] || { echo "No transcript at $transcript"; exit 1; }
      [ $# -gt 0 ] || set -- "$(basename "${transcript%.*}")"
    fi
    idea="$*"; [ -n "$idea" ] || { echo 'Usage: brainstem-proto new "what you want to prototype"   or   brainstem-proto new --transcript call.txt'; exit 1; }
    [ -f "$HOME/.brainstem/src/rapp_brainstem/brainstem.py" ] || { echo "Run the Brainstem one-liner first."; exit 1; }
    name="$(slug "$idea")"; dir="$PROJECTS/$name"; n=2; while [ -e "$dir" ]; do dir="$PROJECTS/$name-$n"; n=$((n+1)); done
    mkdir -p "$PROJECTS"; cp -R "$PROTO_HOME/template" "$dir"; rm -rf "$dir/out" "$dir/.venv"
    read -r bs app < <(free_pair); echo "$bs $app" > "$dir/.proto-ports"
    if [ -n "$transcript" ]; then cp "$transcript" "$dir/discovery/$(basename "$transcript")"; fi
    if [ -n "$template" ]; then  # verified against the published AIBAST registry, or refused
      "$HOME/.brainstem/venv/bin/python" "$PROTO_HOME/templates.py" fetch "$template" "$dir/brainstem/agents" > "$dir/out-template.json" \
        || { echo "Template refused; the prototype was not created."; rm -rf "$dir"; exit 1; }
      tfile=$("$HOME/.brainstem/venv/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["file"])' "$dir/out-template.json"); rm -f "$dir/out-template.json"
      echo "Started from the AIBAST template $template (sha256 verified)."
    fi
    tline=""; [ -n "$template" ] && tline="Start from the AIBAST template already in brainstem/agents/$tfile: keep its structure, adapt it to this customer, and build the page around it."
    if [ -n "$transcript" ]; then cat > "$dir/FIRST-PROMPT.md" <<P
I had a discovery call; the transcript is in discovery/ and DISCOVERY.md is the analysis of it.

Follow AGENTS.md, starting from a discovery call. Show me DISCOVERY.md in plain words and wait for my
go-ahead (gate 1). Then build the MVP "poke" (only its first slice, made-up data), start it, run
scripts/check.sh until it's working, try it yourself, and tell me in one or two lines what to show
the customer. This prototype's Brainstem is on port $bs and the app on port $app.
$tline
P
    else cat > "$dir/FIRST-PROMPT.md" <<P
I want to prototype: $idea

Follow AGENTS.md. Build the first small version that does the most important thing, start it,
run scripts/check.sh until it says it's working, try it yourself in the browser, and then tell me
in one or two lines what to try. Use made-up sample data. This prototype's Brainstem is on port
$bs and the app on port $app.
$tline
P
    fi
    echo "Created $dir"; track prototype_created "\"from_transcript\":$([ -n "$transcript" ] && echo true || echo false)"
    (cd "$dir" && BS_PORT=$bs APP_PORT=$app bash scripts/start-local.sh --no-open >/dev/null) && echo "Started: http://localhost:$app"
    if (cd "$dir" && BS_PORT=$bs APP_PORT=$app bash scripts/check.sh); then track check_passed; else track check_failed; fi
    if [ -n "$transcript" ]; then echo "Reading the discovery call (RAPP step 2)…"; (cd "$dir" && APP_PORT=$app bash scripts/discover.sh "discovery/$(basename "$transcript")") || true; fi
    if command -v pbcopy >/dev/null; then pbcopy < "$dir/FIRST-PROMPT.md"; copied=1; elif command -v xclip >/dev/null; then xclip -selection clipboard < "$dir/FIRST-PROMPT.md"; copied=1; else copied=; fi
    editor=""; for e in code cursor windsurf; do command -v "$e" >/dev/null && { editor="$e"; break; }; done
    [ -n "${PROTO_NO_EDITOR:-}" ] && editor=""
    [ -n "$editor" ] && { "$editor" "$dir" >/dev/null 2>&1 || true; }
    echo
    echo "Next: open your AI${editor:+ (opening $editor now)} in that folder and paste the first prompt${copied:+ (it is on your clipboard)}."
    echo "It's also saved in $dir/FIRST-PROMPT.md"
    ;;
  start)  d=$(project_dir) || { echo "Run this inside a prototype folder."; exit 1; }; read -r bs app < <(ports "$d"); (cd "$d" && BS_PORT=$bs APP_PORT=$app bash scripts/start-local.sh) ;;
  check)  d=$(project_dir) || { echo "Run this inside a prototype folder."; exit 1; }; read -r bs app < <(ports "$d")
          if (cd "$d" && BS_PORT=$bs APP_PORT=$app bash scripts/check.sh); then track check_passed; else track check_failed; exit 1; fi ;;
  stop)   d=$(project_dir) || { echo "Run this inside a prototype folder."; exit 1; }; read -r bs app < <(ports "$d"); (cd "$d" && BS_PORT=$bs APP_PORT=$app bash scripts/stop-local.sh) ;;
  list)   ls -1 "$PROJECTS" 2>/dev/null || echo "No prototypes yet." ;;
  templates) "$HOME/.brainstem/venv/bin/python" "$PROTO_HOME/templates.py" list "$*" ;;
  guide)  # the live RAPP guide drives this computer's Brainstem through a paired, localhost-only bridge
          track guide_opened
          exec "$HOME/.brainstem/venv/bin/python" "$PROTO_HOME/bridge.py" "$@" ;;
  usage)
    f="$PROTO_HOME/usage.jsonl"; [ -f "$f" ] || { echo "No usage recorded yet."; exit 0; }
    echo "On this computer (nothing is sent anywhere):"
    for e in prototype_created check_passed check_failed guide_opened feedback_opened; do printf '  %-18s %s\n' "$e" "$(grep -c "\"event\":\"$e\"" "$f")"; done
    echo "  from a transcript  $(grep -c '"from_transcript":true' "$f")"
    echo "  first use          $(head -1 "$f" | sed -E 's/.*"t":"([^"]+)".*/\1/')"
    echo "Raw log: $f" ;;
  feedback)
    text="$*"; [ -n "$text" ] || { echo 'Usage: brainstem-proto feedback "what you wish it did"'; exit 1; }
    enc() { "$HOME/.brainstem/venv/bin/python" -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"; }
    meta="Pack $PACK_VERSION · $(uname -s) $(uname -m)"
    if [ -n "${PROTO_FEEDBACK_FORM:-}" ]; then url="$PROTO_FEEDBACK_FORM"   # a Microsoft Form link (prefill supported by the form owner)
    else url="https://github.com/$FEEDBACK_REPO/issues/new?labels=feature-request&title=$(enc "Feature request: ${text:0:60}")&body=$(enc "$text

---
$meta (sent by brainstem-proto feedback; no prototype content included)")"; fi
    track feedback_opened
    (command -v open >/dev/null && open "$url") || (command -v xdg-open >/dev/null && xdg-open "$url") || echo "$url"
    echo "Opened a prefilled request. Nothing is sent until you submit it." ;;
  *) cat <<H
brainstem-proto: prototype anything on your Brainstem, with whichever AI you use.
  brainstem-proto new "what you want to prototype"   create it, start it, copy the first prompt for your AI
  brainstem-proto new --transcript call.txt          same, starting from a discovery call (the RAPP process)
  brainstem-proto start | check | stop               inside a prototype folder
  brainstem-proto list                               your prototypes ($PROJECTS)
  brainstem-proto new --template claims-processing --transcript call.txt   start from an AIBAST template
  brainstem-proto templates [search]                 list AIBAST agent templates
  brainstem-proto guide                              open the live RAPP guide, paired to this computer
  brainstem-proto feedback "what you wish it did"    open a prefilled feature request
  brainstem-proto usage                              what this computer has used (stays here)
H
  ;;
esac
