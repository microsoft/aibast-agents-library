    "source_explanations": [
      {
        "sha256": "18b37217a2d4d620da9e83e421b327fa5929d9f5c5b8f697348f4cf3eb3ce126",
        "normalized_text": "downloads = git clones + jsdelivr cdn file hits + github release asset downloads. a clone pulls the whole library; a cdn hit is a single file fetched by an installer, an agent, or a browser. github only exposes a rolling 14-day traffic window, so scripts/build_metrics.py snapshots it into state/metrics_history.json , deduplicated by date — the all-time total grows from the first day of tracking and never double-counts."
      },
      {
        "sha256": "0e14786a83daa37aab6c3651c559d368a254970522ee0eb2446137c2354db5ea",
        "normalized_text": "what is not counted. the install one-liners fetch over raw.githubusercontent.com , which publishes no counter of any kind. installs that take that path are invisible here, so treat every figure on this page as a floor, never a total. installer fetches counts only the copies served through the cdn."
      },
      {
        "sha256": "af5bdca7241895a4c2ecd18cee4e4bc624dfc89dc3ae2e6655ae0ff83390825b",
        "normalized_text": "on clones. github counts every actions/checkout as a clone, and this repository runs registry-build and preflight workflows on push. the estimated ci baseline is published as ci_clone_estimate alongside clones_excluding_ci_estimate in the snapshot. agent file fetches is the narrowest and most trustworthy number on this page."
      },
      {
        "sha256": "7e0f5aa9b9f3a825d67c51738ca4ec07eba4c37dff2f48759f9dfd5ce12552c0",
        "normalized_text": "on unique counts. github reports uniques per 14-day window, not per day, so daily unique figures cannot be summed into a true all-time unique. the headline unique cloners figure is github's own 14-day number; the daily-unique sum beside it is an upper bound, since one machine cloning on three days counts three times. clone counts and cdn hits have no such caveat — they are plain event counts and do accumulate exactly."
      },
      {
        "sha256": "837f6b774fa29946ed86d70b94747edc8cc72b2b6b9ff07eb1aa6ec689e0c1ee",
        "normalized_text": "on traffic gaps. the github traffic endpoints need a token with repository administration read access, which the actions github_token cannot be granted. without a metrics_token secret the snapshot reuses the last authorized read rather than zeroing the figures, and the stamp above says so."
      }
    ],
    "download_formula": {
      "components": [
        "totals.clones",
        "totals.cdn_hits",
        "totals.release_downloads"
      ],
      "live_top_up": "M.totals.downloads += (hits - M.totals.cdn_hits)"
    },
    "distinct_fetch_metrics": [
      "totals.agent_file_downloads",
      "totals.installer_downloads"
    ],
