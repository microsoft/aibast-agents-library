{
  "schema": "aibast-deployment-recipe/1.0",
  "name": "@aibast-agents-library/invoice-processing",
  "display_name": "Invoice Processing",
  "registry_url": "https://raw.githubusercontent.com/microsoft/aibast-agents-library/main/registry.json",
  "source_url": "https://raw.githubusercontent.com/microsoft/aibast-agents-library/main/agents/@aibast-agents-library/general_stacks/invoice_processing_stack/invoice_ledger_agent.py",
  "source_path": "agents/@aibast-agents-library/general_stacks/invoice_processing_stack/invoice_ledger_agent.py",
  "target_filename": "invoice_ledger_agent.py",
  "expected_tool": "InvoiceLedger",
  "smoke_test": {
    "prompt": "Of the sample invoices on file, which ones get logged, which are duplicates, and which were only partly read?",
    "arguments": {
      "operation": "ledger_decisions"
    },
    "must_call": "InvoiceLedger",
    "must_include": [
      "FAB-1043",
      "INV-ROW-0001",
      "CS-5521"
    ]
  },
  "brainstem": {
    "health_url": "http://localhost:7071/health",
    "chat_url": "http://localhost:7071/chat",
    "ui_url": "http://localhost:7071",
    "installers": {
      "macos_linux": "https://microsoft.github.io/aibast-agents-library/install.sh",
      "windows_powershell": "https://microsoft.github.io/aibast-agents-library/install.ps1",
      "windows_cmd": "https://microsoft.github.io/aibast-agents-library/install.cmd"
    },
    "default_source_dir": "~/.brainstem/src/rapp_brainstem",
    "default_agents_dir": "~/.brainstem/src/rapp_brainstem/agents",
    "policy_clean_launcher_dir": "~/.copilot/bin"
  },
  "copilot_studio": {
    "plugin": "mcs-assistant@copilot-studio-plugin",
    "minimum_pac_version": "2.9.3",
    "authoring_mode": "cli-copilot",
    "status": "source-package-ready-not-deployed",
    "operations": [
      "ledger_decisions"
    ],
    "manual_global_instructions": "manual/GLOBAL-INSTRUCTIONS.md",
    "manual_knowledge_files": [
      "manual/knowledge/aibast_invoice-processing-synthetic-records.md",
      "manual/knowledge/aibast_invoice-processing-rules-and-guardrails.md"
    ],
    "manual_skill_count": 1,
    "required_connections": [
      "A shared mailbox and an invoice ledger list with read-only access (for real use; the pilot uses bundled synthetic records)"
    ],
    "publish_requires_confirmation": true,
    "validated_manual": {
      "display_name": "Invoice Processing Manual",
      "bot_id": "8db133e0-8833-41db-bb43-9ad4667e65fb",
      "environment_name": "kodyv8",
      "environment_id": "ee67a404-325c-e726-a18a-886fe708ca0b",
      "skills": 1,
      "knowledge_files": 2
    },
    "validated_pilot": {
      "display_name": "Invoice Processing Pilot",
      "bot_id": "16bc808f-c72c-45bb-bd51-56dbd93e4f11",
      "schema_name": "aibast_InvoiceProcessingPilot",
      "environment_name": "kodyv8",
      "environment_id": "ee67a404-325c-e726-a18a-886fe708ca0b"
    }
  },
  "origin": {
    "source": "Copilot Studio Gallery",
    "solution": "invoice-processing",
    "license": "MIT",
    "note": "Built on the gallery solution; their package stays theirs and unchanged."
  },
  "write_controls": {
    "authenticated_tools_required": true,
    "explicit_human_approval_required": true,
    "authorization_check_required": true,
    "audit_log_required": true,
    "local_demo_performs_writes": false
  }
}
