  "name": "@aibast-agents-library/engineering-standards-advisor",
  "display_name": "Engineering Standards Agent",
  "registry_url": "https://raw.githubusercontent.com/microsoft/aibast-agents-library/main/registry.json",
  "source_url": "https://raw.githubusercontent.com/microsoft/aibast-agents-library/main/agents/@aibast-agents-library/energy_stacks/engineering_standards_advisor_stack/engineering_standards_advisor_agent.py",
  "source_path": "agents/@aibast-agents-library/energy_stacks/engineering_standards_advisor_stack/engineering_standards_advisor_agent.py",
  "target_filename": "engineering_standards_advisor_agent.py",
  "expected_tool": "EngineeringStandardsAgent",
  "brainstem": {
    "health_url": "http://localhost:7071/health",
    "chat_url": "http://localhost:7071/chat",
    "ui_url": "http://localhost:7071",
    "installers": {
      "macos_linux": "https://microsoft.github.io/aibast-agents-library/install.sh",
      "windows_powershell": "https://microsoft.github.io/aibast-agents-library/install.ps1",
      "windows_cmd": "https://microsoft.github.io/aibast-agents-library/install.cmd"
    },
    "default_source_dir": "~/.brainstem/src/rapp_brainstem",
    "default_agents_dir": "~/.brainstem/src/rapp_brainstem/agents",
    "policy_clean_launcher_dir": "~/.copilot/bin"
  },
  "smoke_test": {
    "prompt": "What is the minimum clearance for a primary conductor over a public road?",
    "arguments": {
      "operation": "vetted_lookup",
      "topic": "road_clearance"
    },
    "must_call": "EngineeringStandardsAgent",
    "must_include": [
      "6.5 m",
      "QR-210-01"
    ]
  },
  "demo_scenarios": [
    {
      "case_id": "ESA-01",
      "persona": "Design Technician",
      "prompt": "What is the minimum clearance for a primary conductor over a public road?",
      "operation": "vetted_lookup"
    },
    {
      "case_id": "ESA-02",
      "persona": "Design Technician",
      "prompt": "Can I use a Class 5 pole on a 35-degree corner that carries a 75 kVA transformer?",
      "operation": "interpretation"
    },
    {
      "case_id": "ESA-03",
      "persona": "Design Technician",
      "prompt": "Send the corner-pole interpretation to a standards engineer to confirm.",
      "operation": "flag_for_review"
    },
    {
      "case_id": "ESA-04",
      "persona": "Standards Engineer",
      "prompt": "What is waiting in my standards review queue?",
      "operation": "review_queue"
    },
    {
      "case_id": "ESA-05",
      "persona": "Standards Engineer",
      "prompt": "Show the overhead clearances quick-reference sheet and anything due for re-vetting.",
      "operation": "quick_reference"
    },
    {
      "case_id": "ESA-06",
      "persona": "Field Engineering Lead",
      "prompt": "Scope the Maple Ridge pole replacement job: risk, effort and the standards that apply.",
      "operation": "scope_job"
    }
  ],
  "write_controls": {
    "mode": "read-only-synthetic",
    "external_writes": "none",
    "statement": "Never present an unvetted interpretation as approved, approve a design, change a standard or a quick-reference row, submit a review, release work, or replace engineering judgment.",
    "human_gate": "A standards engineer vets interpretations and re-vets revised rows; the design engineer confirms site conditions, scope, crews and outages before any design is issued."
  },
  "copilot_studio": {
    "plugin": "mcs-assistant@copilot-studio-plugin",
    "minimum_pac_version": "2.9.3",
    "authoring_mode": "cli-copilot",
    "status": "source-package-ready-not-deployed",
    "operations": [
