      "kwargs": {
        "operation": "emergency_response",
        "service_request_id": "SR-4005"
      },
      "must_include": [
        "Emergency Response Draft",
        "Marcus Thompson",
        "No field action"
      ],
      "expects_agent": "FieldServiceDispatchAgent"
