{
  "schema": "aibast-persona-cases/1.0",
  "solution": "Asset Maintenance Forecast Agent",
  "agent": "@aibast-agents-library/asset-maintenance-forecast",
  "onepager": "Energy Operations Agent Suite one-pager (2).pptx",
  "cases": [
    {
      "id": "ASSET_MAINTENANCE_FORECAST-01",
      "operation": "maintenance_forecast",
      "persona": "Plant Manager",
      "prompt": "I need immediate analysis on our wind farm turbines",
      "kwargs": {
        "operation": "maintenance_forecast"
      },
      "must_include": [
        "Unit 12",
        "8.7/10",
        "March 18-22"
      ],
      "expects_agent": "AssetMaintenanceForecastAgent"
    },
    {
      "id": "ASSET_MAINTENANCE_FORECAST-02",
      "operation": "asset_health",
      "persona": "Reliability Engineer",
      "prompt": "Show me the weakest turbine condition and whether this is an operating authorization.",
      "kwargs": {
        "operation": "asset_health"
      },
      "must_include": [
        "Unit 12",
        "CRITICAL",
        "not a safety determination"
      ],
      "expects_agent": "AssetMaintenanceForecastAgent"
    },
    {
      "id": "ASSET_MAINTENANCE_FORECAST-03",
      "operation": "budget_projection",
      "persona": "Finance Business Partner",
      "prompt": "What maintenance funding should I reserve for the at-risk turbines?",
      "kwargs": {
        "operation": "budget_projection"
      },
      "must_include": [
        "$70,200",
        "$227,000",
        "Synthetic planning estimate"
      ],
      "expects_agent": "AssetMaintenanceForecastAgent"
    },
    {
      "id": "ASSET_MAINTENANCE_FORECAST-04",
      "operation": "work_order_plan",
      "persona": "Maintenance Planner",
      "prompt": "Draft the bundled maintenance plan for the at-risk turbines, but do not create any work orders.",
      "kwargs": {
        "operation": "work_order_plan"
      },
      "must_include": [
        "Bundled Maintenance Plan",
        "258%",
        "No work order"
      ],
      "expects_agent": "AssetMaintenanceForecastAgent"
    }
  ],
  "assertion_principle": "One persona case per operation; assertions use deterministic source evidence and explicit safety language.",
  "agent_files": [
    "asset_maintenance_forecast_agent"
  ]
}
