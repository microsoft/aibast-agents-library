{
  "schema": "aibast-persona-cases/1.0",
  "solution": "Permit Management Agent",
  "agent": "@aibast-agents-library/permit-license-management",
  "onepager": "Energy Operations Agent Suite one-pager (2).pptx",
  "cases": [
    {
      "id": "PERMIT_LICENSE_MANAGEMENT-01",
      "operation": "permit_inventory",
      "persona": "Facility Manager",
      "prompt": "Show me our permit status and any expiring soon",
      "kwargs": {
        "operation": "permit_inventory"
      },
      "must_include": [
        "240 active permits",
        "Imperial Valley Solar",
        "$47M"
      ],
      "expects_agent": "PermitLicenseManagementAgent"
    },
    {
      "id": "PERMIT_LICENSE_MANAGEMENT-02",
      "operation": "renewal_calendar",
      "persona": "Permit Coordinator",
      "prompt": "Which permit renewals have already missed their lead time, and how many days are left?",
      "kwargs": {
        "operation": "renewal_calendar"
      },
      "must_include": [
        "Reno Wind Farm",
        "MISSED",
        "No renewal"
      ],
      "expects_agent": "PermitLicenseManagementAgent"
    },
    {
      "id": "PERMIT_LICENSE_MANAGEMENT-03",
      "operation": "compliance_gaps",
      "persona": "Compliance Manager",
      "prompt": "What permit evidence gap needs immediate authorized review?",
      "kwargs": {
        "operation": "compliance_gaps"
      },
      "must_include": [
        "renewal_lead_time_missed",
        "CRITICAL",
        "not legal advice"
      ],
      "expects_agent": "PermitLicenseManagementAgent"
    },
    {
      "id": "PERMIT_LICENSE_MANAGEMENT-04",
      "operation": "application_status",
      "persona": "Environmental Counsel",
      "prompt": "Where does the Imperial Valley Solar Phase 2 application stand, and did we submit anything today?",
      "kwargs": {
        "operation": "application_status",
        "facility": "Imperial Valley"
      },
      "must_include": [
        "APP-7102",
        "public_comment",
        "cannot submit"
      ],
      "expects_agent": "PermitLicenseManagementAgent"
    },
    {
      "id": "PERMIT_LICENSE_MANAGEMENT-05",
      "operation": "renewal_plan",
      "persona": "Operations Director",
      "prompt": "Start emergency renewals for the critical permits.",
      "kwargs": {
        "operation": "renewal_plan"
      },
      "must_include": [
        "$685,000",
        "$13.8M",
        "No application was submitted"
      ],
      "expects_agent": "PermitLicenseManagementAgent"
    }
  ],
  "assertion_principle": "One persona case per operation; assertions use deterministic source evidence and explicit safety language.",
  "agent_files": [
    "permit_license_management_agent"
  ]
}
