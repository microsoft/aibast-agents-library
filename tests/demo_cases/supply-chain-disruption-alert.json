{
  "schema": "aibast-persona-cases/1.0",
  "solution": "Supply Chain Disruption Alert Agent",
  "agent": "@aibast-agents-library/supply-chain-disruption-alert",
  "onepager": "35. Supply Chain Disruption Alert Agent one-pager.pptx",
  "cases": [
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-01",
      "operation": "disruption_dashboard",
      "persona": "Customer Fulfillment Lead",
      "prompt": "Which active disruption has the largest modeled impact and what is affected?",
      "kwargs": {
        "operation": "disruption_dashboard"
      },
      "must_include": [
        "DISR-002",
        "$3,800,000.00",
        "SKU-1010"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-02",
      "operation": "risk_assessment",
      "persona": "Supply Chain Planner",
      "prompt": "Why is RT-APAC-01 high risk?",
      "kwargs": {
        "operation": "risk_assessment",
        "route_id": "RT-APAC-01"
      },
      "must_include": [
        "Asia-Pacific Primary",
        "HIGH",
        "Weather"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-03",
      "operation": "mitigation_plan",
      "persona": "Operations Leader",
      "prompt": "Draft a DISR-002 mitigation scenario without rerouting or moving inventory.",
      "kwargs": {
        "operation": "mitigation_plan",
        "disruption_id": "DISR-002"
      },
      "must_include": [
        "DISR-002",
        "Draft Disruption Mitigation Scenario",
        "no purchase order"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-04",
      "operation": "supplier_alternatives",
      "persona": "Procurement Manager",
      "prompt": "Show Electronics alternatives without activating a supplier.",
      "kwargs": {
        "operation": "supplier_alternatives",
        "category": "Electronics"
      },
      "must_include": [
        "TechSource Taiwan",
        "due diligence",
        "human approval"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-05",
      "operation": "root_cause_analysis",
      "persona": "Regional Retail Manager",
      "onepager_bullet": "Score severity and determine impacted SKUs, orders, and revenue exposure",
      "prompt": "I'm seeing unusual inventory movement at our Northwest stores. Can you help me understand what's happening?",
      "kwargs": {
        "operation": "root_cause_analysis"
      },
      "must_include": [
        "Portland DC",
        "143 products",
        "$84,300/week"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-06",
      "operation": "emergency_options",
      "persona": "Regional Operations Director",
      "onepager_bullet": "Compare backup sourcing, inventory shifts, and routing alternatives",
      "prompt": "What are our emergency options and costs?",
      "kwargs": {
        "operation": "emergency_options"
      },
      "must_include": [
        "Denver DC Emergency Transfer",
        "$15,600",
        "3:1"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-07",
      "operation": "transfer_plan",
      "persona": "Store Operations Manager",
      "onepager_bullet": "Recommend the best mitigation plan based on cost and lead time",
      "prompt": "Approved. Execute both Seattle and the 5 additional stores.",
      "kwargs": {
        "operation": "transfer_plan"
      },
      "must_include": [
        "ready to release",
        "$24,500",
        "$78,000"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-08",
      "operation": "recovery_plan",
      "persona": "Distribution Center Manager",
      "onepager_bullet": "Detect supplier issues and logistics disruptions in real time",
      "prompt": "Activate tracking and show me the Portland DC recovery plan.",
      "kwargs": {
        "operation": "recovery_plan"
      },
      "must_include": [
        "Conveyor repair",
        "340 pending orders",
        "Friday noon"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-09",
      "operation": "incident_report",
      "persona": "Finance Business Partner",
      "onepager_bullet": "Recommend the best mitigation plan based on cost and lead time",
      "prompt": "Create the executive report with financial impact.",
      "kwargs": {
        "operation": "incident_report"
      },
      "must_include": [
        "Executive Incident Report",
        "$53,500",
        "47 minutes"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    },
    {
      "id": "SUPPLY_CHAIN_DISRUPTION_ALERT-10",
      "operation": "incident_summary",
      "persona": "Supply Chain Director",
      "onepager_bullet": "Detect supplier issues and logistics disruptions in real time",
      "prompt": "Distribute the report and summarize what we accomplished.",
      "kwargs": {
        "operation": "incident_summary"
      },
      "must_include": [
        "Crisis Response Summary",
        "not sent",
        "all 47 stores"
      ],
      "must_not_include": [
        "I do not have access",
        "I cannot help"
      ],
      "expects_agent": "supply-chain-disruption-alert-agent"
    }
  ],
  "assertion_principle": "One persona case per operation; assertions use deterministic source evidence and explicit safety language.",
  "agent_files": [
    "supply_chain_disruption_alert_agent"
  ]
}
